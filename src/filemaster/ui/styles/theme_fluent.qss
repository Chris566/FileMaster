/* ============================================================
 * FileMaster — Fluent Acrylic 主题
 * Windows 11 风格的微透明 + 圆角 + 强调色
 * 主色：#0078D4
 * ============================================================ */

QWidget {
    font-family: "Segoe UI Variable", "Segoe UI", "Microsoft YaHei", sans-serif;
    font-size: 10pt;
    color: #1F1F1F;
    background-color: #F3F3F3;
}

QMainWindow {
    background-color: #F3F3F3;
}

QMenuBar {
    background-color: rgba(243, 243, 243, 0.85);
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    padding: 4px;
}
QMenuBar::item {
    padding: 8px 14px;
    background: transparent;
    border-radius: 6px;
}
QMenuBar::item:selected {
    background-color: rgba(0, 120, 212, 0.08);
    color: #0078D4;
}

QToolBar {
    background-color: rgba(255, 255, 255, 0.7);
    border-bottom: 1px solid rgba(0, 0, 0, 0.04);
    spacing: 6px;
    padding: 6px;
}

/* Acrylic 圆角按钮 */
QPushButton {
    background-color: rgba(255, 255, 255, 0.9);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    padding: 8px 20px;
    min-height: 20px;
}
QPushButton:hover {
    background-color: rgba(255, 255, 255, 1.0);
    border-color: rgba(0, 0, 0, 0.12);
    border-width: 1px;
}
QPushButton:pressed {
    background-color: rgba(0, 0, 0, 0.04);
}
QPushButton:disabled {
    background-color: rgba(255, 255, 255, 0.4);
    color: #A0A0A0;
}

QPushButton[role="primary"] {
    background-color: #0078D4;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}
QPushButton[role="primary"]:hover {
    background-color: #0086F0;
}
QPushButton[role="primary"]:pressed {
    background-color: #006ABC;
}

QPushButton[role="danger"] {
    background-color: #D83B01;
    color: #FFFFFF;
    border: none;
    font-weight: 600;
}
QPushButton[role="danger"]:hover {
    background-color: #E55B2E;
}

QLineEdit, QTextEdit, QPlainTextEdit, QSpinBox {
    background-color: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    padding: 6px 10px;
}
QLineEdit:focus, QTextEdit:focus, QPlainTextEdit:focus {
    border-color: #0078D4;
    border-width: 2px;
    padding: 5px 9px;
    background-color: #FFFFFF;
}

QComboBox {
    background-color: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    padding: 6px 24px 6px 10px;
    min-height: 20px;
}
QComboBox:hover {
    border-color: rgba(0, 0, 0, 0.12);
}
QComboBox::drop-down {
    border: none;
    width: 24px;
}
QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #606060;
    margin-right: 10px;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    selection-background-color: #E5F1FB;
    selection-color: #0078D4;
    padding: 4px;
}

QCheckBox {
    spacing: 8px;
    background: transparent;
}
QCheckBox::indicator {
    width: 18px;
    height: 18px;
    border: 1.5px solid #B0B0B0;
    border-radius: 4px;
    background-color: #FFFFFF;
}
QCheckBox::indicator:hover {
    border-color: #0078D4;
}
QCheckBox::indicator:checked {
    background-color: #0078D4;
    border-color: #0078D4;
    /* 用符号：✓（ASCII fallback） */
    color: white;
}

QProgressBar {
    background-color: rgba(0, 0, 0, 0.04);
    border: none;
    border-radius: 8px;
    text-align: center;
    min-height: 8px;
    max-height: 8px;
    color: #1F1F1F;
}
QProgressBar::chunk {
    background-color: #0078D4;
    border-radius: 8px;
}

QGroupBox {
    background-color: rgba(255, 255, 255, 0.95);
    border: 1px solid rgba(0, 0, 0, 0.06);
    border-radius: 8px;
    margin-top: 16px;
    padding: 14px;
    font-weight: 600;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 0 8px;
    background-color: #F3F3F3;
    color: #0078D4;
}

QListView, QTreeView, QTableView, QTableWidget, QTreeWidget {
    background-color: #FFFFFF;
    alternate-background-color: #FAFAFA;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    gridline-color: rgba(0, 0, 0, 0.04);
    selection-background-color: #E5F1FB;
    selection-color: #0078D4;
}
QHeaderView::section {
    background-color: #F8F8F8;
    border: none;
    border-right: 1px solid rgba(0, 0, 0, 0.04);
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    padding: 8px;
    font-weight: 600;
    color: #1F1F1F;
}

QScrollBar:vertical {
    background: transparent;
    width: 10px;
}
QScrollBar::handle:vertical {
    background: rgba(0, 0, 0, 0.25);
    border-radius: 5px;
    min-height: 24px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(0, 0, 0, 0.4);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar:horizontal {
    background: transparent;
    height: 10px;
}
QScrollBar::handle:horizontal {
    background: rgba(0, 0, 0, 0.25);
    border-radius: 5px;
    min-width: 24px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(0, 0, 0, 0.4);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}

QStatusBar {
    background-color: rgba(243, 243, 243, 0.85);
    border-top: 1px solid rgba(0, 0, 0, 0.04);
    color: #606060;
}

QLabel {
    background: transparent;
    color: #1F1F1F;
}
QLabel[role="header"] {
    font-size: 18pt;
    font-weight: 700;
    color: #0078D4;
    padding: 8px 0;
}
QLabel[role="muted"] {
    color: #808080;
    font-size: 9pt;
}

QTabWidget::pane {
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 6px;
    background-color: #FFFFFF;
    margin-top: -1px;
}
QTabBar::tab {
    background-color: transparent;
    color: #606060;
    padding: 10px 22px;
    border-bottom: 2px solid transparent;
}
QTabBar::tab:selected {
    color: #0078D4;
    border-bottom: 2px solid #0078D4;
    font-weight: 600;
}
QTabBar::tab:hover:!selected {
    color: #0078D4;
    background-color: rgba(0, 120, 212, 0.04);
}
